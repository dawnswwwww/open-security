{
  "name": "@dawnswwwww/open-security",
  "version": "0.2.1",
  "description": "LLM-driven security diff scanner with a pluggable agent runtime (Claude Agent SDK by default, OpenAI-compatible endpoints and ACP agents supported)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawnswwwww/open-security.git"
  },
  "bugs": {
    "url": "https://github.com/dawnswwwww/open-security/issues"
  },
  "homepage": "https://github.com/dawnswwwww/open-security#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "open-security": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
